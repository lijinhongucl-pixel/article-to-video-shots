{
  "$comment": "各 Agent 的技能目录配置。新增平台只需加一条，不用改代码。detect 用来判断本机有没有装这个 agent；user / project 是技能目录候选，按顺序取第一个可用的；status 是确认程度，verified 官方文档确认、community 社区实践验证、experimental 尚未验证。",
  "adapters": [
    {
      "id": "workbuddy",
      "name": "WorkBuddy",
      "detect": ["~/.workbuddy"],
      "user": ["~/.workbuddy/skills"],
      "project": [".workbuddy/skills"],
      "status": "verified"
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "detect": ["~/.claude"],
      "user": ["~/.claude/skills"],
      "project": [".claude/skills"],
      "status": "verified"
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "detect": ["~/.codex"],
      "user": ["~/.codex/skills", "~/.config/codex/skills"],
      "project": [".codex/skills"],
      "status": "community"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "detect": ["~/.cursor"],
      "user": ["~/.cursor/skills"],
      "project": [".cursor/skills"],
      "status": "community"
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "detect": ["~/.gemini"],
      "user": ["~/.gemini/skills"],
      "project": [".gemini/skills"],
      "status": "experimental"
    },
    {
      "id": "trae",
      "name": "Trae",
      "detect": ["~/.trae"],
      "user": [],
      "project": [".trae/skills"],
      "status": "experimental"
    }
  ]
}
